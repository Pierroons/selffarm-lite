#!/usr/bin/env bash
# Hook pre-push — dernier filet avant que le contenu devienne public.
#
# Le pre-commit ne voit que ce qui est indexé. Il est aveugle à ce qui dort
# déjà dans le dépôt : une donnée entrée il y a trois mois, ou reprise d'un
# ancien commit. Le pre-push examine l'historique COMPLET, et c'est le dernier
# moment où l'erreur reste réversible sans ticket au support : une fois
# poussée, il faut réécrire l'historique, re-signer les tags, purger le
# registre d'images et demander à GitHub de collecter les objets orphelins.
#
# Il délègue à scripts/audit-opsec.sh, qui couvre les quatre angles morts de
# gitleaks : contenu de tout l'historique, messages de commit, fichiers
# disparus du HEAD, et métadonnées des binaires.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# ═══ Gel des envois ═══════════════════════════════════════════════════════════
# Un gel annoncé et non appliqué n'est qu'un souhait : plusieurs sessions
# travaillent dans ce dépôt et aucune ne lit les messages des autres. La
# contrainte vit donc ici, où elle s'oppose au geste.
#
# Le motif est dans un FICHIER, pas dans ce hook : lever le gel doit être un
# geste explicite et visible (`rm`), jamais une édition du garde-fou — on
# n'apprend pas à contourner sa propre alarme.
# 🔑 Le répertoire git COMMUN, et non `$ROOT/.git` : dans un arbre de travail
# secondaire `.git` est un fichier, le test `-f` y serait faux en silence et le
# gel ne s'opposerait à rien. Commun, un seul fichier couvre tous les arbres.
GEL="$(git rev-parse --path-format=absolute --git-common-dir)/PUSH-GEL"
if [ -f "$GEL" ]; then
  printf '\n\033[31m✗ Envoi refusé — les envois sont gelés.\033[0m\n\n' >&2
  sed 's/^/  /' "$GEL" >&2
  printf '\n  Lever le gel :  rm %s\n\n' "$GEL" >&2
  exit 1
fi


# Rappel du jugement, que l'audit ci-dessous ne fait pas : il cherche des motifs,
# pas une phrase de vie privée dans une description de PR.
#
# Conditionné à l'existence de la commande, qui vit hors du dépôt : sans cette
# garde, quiconque clone verrait un rappel vers quelque chose qu'il n'a pas.
if [ -f "$HOME/.claude/commands/pre-push.md" ]; then
  echo "↪ /pre-push passé sur ce diff ? (l'audit ci-dessous est mécanique)"
fi

# Ce que cet envoi AJOUTE, et non tout ce que le dépôt contient. Un motif entré
# il y a quatre mois est déjà public : aucun envoi ne l'aggrave, aucun envoi ne
# le corrige, et le blocage n'a d'autre effet que d'apprendre à contourner le
# hook. Ce qui reste dans le passé se traite par git-filter-repo, pas ici.
# Sans amont — première publication d'une branche — on retombe sur l'audit
# complet : c'est le cas où rien n'a encore été vu par personne.
#
# 🔑 Le périmètre se lit sur STDIN, pas sur `@{u}`. Git y écrit une ligne par
# référence réellement poussée : « <ref locale> <sha local> <ref distante>
# <sha distant> ». La branche de suivi ne dit QUE la destination habituelle.
#
# Mesuré le 21/08/2026 : une avance de `main` depuis `dev` a publié treize
# commits pendant que le hook mesurait `origin/dev..HEAD`, soit zéro. L'audit
# a rendu « ✓ Rien à signaler » sans avoir rien lu — et c'est la manœuvre
# employée à CHAQUE publication vers `main`. La ligne « aucun commit dans le
# périmètre — rien n'a été lu » a sauvé l'honnêteté du verdict ; elle n'a pas
# empêché l'envoi.
ZERO='0000000000000000000000000000000000000000'
PLAGES=()
# Références n'apportant aucun commit que le distant n'ait déjà — un tag posé
# ou déplacé sur du déjà-publié. Leur seul contenu inédit est leur propre
# message, qui est audité comme tel.
SANS_COMMIT_NOUVEAU=()
COMPLET=0
LIGNES=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ -z "${LOCAL_REF:-}" ] && continue
  LIGNES=$((LIGNES + 1))
  # Suppression d'une référence distante : rien de nouveau n'est publié.
  [ "$LOCAL_SHA" = "$ZERO" ] && continue
  if [ "$REMOTE_SHA" = "$ZERO" ]; then
    # Une référence neuve n'implique pas des OBJETS neufs. Un tag posé sur un
    # commit déjà publié n'ajoute que lui-même : auditer alors l'historique
    # complet fait rougir un passé que cet envoi ne peut ni aggraver ni
    # corriger, et la seule issue devient --no-verify — donc plus d'audit du
    # tout, y compris sur ce que le tag, lui, publie vraiment.
    #
    # Mesuré le 22/08/2026 : selfmoderate-v0.3.0, posé sur la tête d'origin/dev,
    # ajoutait 0 commit et 1 objet — le tag. L'audit a listé cinq motifs déjà
    # publiés depuis des mois et bloqué l'envoi.
    #
    # Le périmètre se mesure donc sur ce que le distant ne possède pas encore.
    # En cas de doute (rev-list muet), on retombe sur l'audit complet : le
    # défaut de mesure ne doit pas se traduire par un relâchement.
    if [ "$(git rev-list --count "$LOCAL_SHA" --not --remotes=origin 2>/dev/null || echo 1)" = "0" ]; then
      SANS_COMMIT_NOUVEAU+=("$LOCAL_REF|$LOCAL_SHA")
    else
      COMPLET=1
    fi
  else
    # Une référence DÉPLACÉE mérite la même mesure qu'une référence neuve. Le
    # raisonnement ci-dessus vaut mot pour mot ici, et il n'y était pas :
    # mesuré le 23/08/2026, le repointage de cinq tags sur des commits déjà
    # présents dans main a été compté « 64 à 131 commits à publier », alors
    # qu'aucun des cinq n'apportait un seul objet nouveau. L'audit a rougi sur
    # un passé que cet envoi ne pouvait ni aggraver ni corriger, et la seule
    # issue restante était --no-verify.
    if [ "$(git rev-list --count "$LOCAL_SHA" --not --remotes=origin 2>/dev/null || echo 1)" = "0" ]; then
      SANS_COMMIT_NOUVEAU+=("$LOCAL_REF|$LOCAL_SHA")
    else
      PLAGES+=("$REMOTE_SHA..$LOCAL_SHA")
    fi
  fi
done

ARGS=()
if [ "$LIGNES" = "0" ]; then
  # Appelé à la main, hors d'un envoi : pas de stdin. On retombe sur la branche
  # de suivi, en le disant — un périmètre deviné n'est pas un périmètre lu.
  if UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
    ARGS=(--range "$UPSTREAM..HEAD")
    echo "▸ Périmètre : $(git rev-list --count "$UPSTREAM..HEAD") commit(s) — déduit de la branche amont ($UPSTREAM..HEAD), aucun envoi en cours"
  else
    echo "▸ Périmètre : historique complet (aucune branche amont)"
  fi
elif [ "$COMPLET" = "1" ]; then
  echo "▸ Périmètre : historique complet (référence distante nouvelle)"
elif [ ${#PLAGES[@]} -eq 0 ] && [ ${#SANS_COMMIT_NOUVEAU[@]} -eq 0 ]; then
  echo "▸ Périmètre : suppression de référence, rien à publier"
  exit 0
fi

for ENTREE in "${SANS_COMMIT_NOUVEAU[@]}"; do
  echo "▸ Périmètre : ${ENTREE%%|*} — sur un historique déjà publié, 0 commit nouveau ; seul son message est inédit"
done

# Une plage par référence poussée : un envoi peut en viser deux d'un coup, et
# n'en auditer qu'une laisserait passer l'autre en silence.
if [ ${#PLAGES[@]} -gt 0 ] && [ "$COMPLET" = "0" ]; then
  for PLAGE in "${PLAGES[@]}"; do
    # 🔑 La plage peut être INUTILISABLE ici : après une réécriture d'historique,
    # le SHA que porte le distant n'existe plus dans ce dépôt. `rev-list` sortait
    # alors en « Invalid revision range » — une ligne `fatal` au milieu du
    # rapport, suivie d'un compte vide, et l'audit continuait comme si de rien
    # n'était. On mesure d'abord, et on annonce le repli plutôt qu'un chiffre
    # absent. L'audit fait le même constat de son côté et bascule en complet.
    if N=$(git rev-list --count "$PLAGE" 2>/dev/null); then
      echo "▸ Périmètre : $N commit(s) à publier ($PLAGE)"
    else
      echo "▸ Périmètre : plage inutilisable — le distant ne partage plus cet"
      echo "              historique. L'audit relira TOUT, ce qui est le bon"
      echo "              périmètre pour un envoi forcé après réécriture."
    fi
  done
fi

# Rend 0 si l'audit ÉCHOUE, pour se lire « if echec_audit; then bloquer ».
echec_audit() {
  # Le message d'un tag annoté est publié pour la première fois : il s'audite,
  # même quand la référence n'apporte aucun commit. Sans ça, la correction du
  # périmètre ouvrirait un trou là où elle ferme une alarme morte.
  if [ "$COMPLET" = "0" ]; then
    for ENTREE in "${SANS_COMMIT_NOUVEAU[@]}"; do
      SHA="${ENTREE##*|}"
      [ "$(git cat-file -t "$SHA" 2>/dev/null)" = "tag" ] || continue
      TMP=$(mktemp)
      git cat-file -p "$SHA" | sed -n '/^$/,$p' > "$TMP"
      if ! "$ROOT/scripts/audit-opsec.sh" --message "$TMP"; then
        rm -f "$TMP"
        return 0
      fi
      rm -f "$TMP"
    done
  fi
  if [ ${#PLAGES[@]} -gt 0 ] && [ "$COMPLET" = "0" ]; then
    for PLAGE in "${PLAGES[@]}"; do
      "$ROOT/scripts/audit-opsec.sh" --range "$PLAGE" || return 0
    done
    return 1
  fi
  # Uniquement des références neuves sans commit : leurs messages viennent
  # d'être audités, il n'y a pas d'autre contenu à lire.
  if [ "$COMPLET" = "0" ] && [ ${#SANS_COMMIT_NOUVEAU[@]} -gt 0 ]; then
    return 1
  fi
  "$ROOT/scripts/audit-opsec.sh" "${ARGS[@]}" || return 0
  return 1
}

if [ -x "$ROOT/scripts/audit-opsec.sh" ]; then
  if echec_audit; then
    echo ""
    echo "❌ PUSH BLOQUÉ."
    echo "   Si la donnée est déjà commitée, la corriger maintenant ne la"
    echo "   retire PAS de l'historique — il faudra git-filter-repo."
    echo "   Passer outre en connaissance de cause : git push --no-verify"
    exit 1
  fi
  exit 0
fi

# Repli si l'audit ne peut pas tourner : au moins les secrets et les images.
#
# Le test porte sur le bit d'exécution, pas sur l'existence — le message disait
# « introuvable » dans les deux cas. Un dépôt restauré d'une archive, une copie
# passée par un partage qui ne conserve pas les bits, ou scripts/install-hooks.sh
# jamais lancé (c'est lui qui fait le chmod +x) donnent un script bien présent et
# non exécutable. Nommer la vraie condition, sinon on cherche au mauvais endroit.
if [ -f "$ROOT/scripts/audit-opsec.sh" ]; then
  echo "⚠ scripts/audit-opsec.sh présent mais non exécutable."
  echo "  → scripts/install-hooks.sh pose le bit d'exécution."
else
  echo "⚠ scripts/audit-opsec.sh introuvable."
fi
echo "  Contrôle réduit aux secrets et aux images."
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks detect --source "$ROOT" -c "$ROOT/.gitleaks.toml" \
       --no-banner --redact >/dev/null 2>&1; then
    echo "❌ PUSH BLOQUÉ — donnée sensible dans l'historique."
    gitleaks detect --source "$ROOT" -c "$ROOT/.gitleaks.toml" \
      --no-banner --redact -v 2>&1 | grep -E "RuleID:|File:|Line:" | head -12
    exit 1
  fi
else
  echo "⚠ gitleaks absent — installe le binaire officiel :"
  echo "  https://github.com/gitleaks/gitleaks/releases"
fi

# 🔑 Un repli n'est pas la barrière annoncée. Le script se terminait ici sur un
# echo, donc en 0 sous `set -e` : le même verdict qu'un audit complet réussi,
# alors que trois contrôles sur quatre n'avaient pas tourné.
echo ""
echo "❌ BLOQUÉ — l'audit complet n'a pas pu s'exécuter."
echo "   Les messages de commit, les orphelins et le contenu de l'historique"
echo "   n'ont PAS été examinés. Répare, ou passe outre en connaissance de"
echo "   cause avec l'option --no-verify."
exit 1
