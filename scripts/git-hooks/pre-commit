#!/usr/bin/env bash
# Hook pre-commit — le moment où une fuite coûte le moins cher à réparer.
#
# Ce hook ne regarde que ce qui est INDEXÉ. C'est sa force : rien n'est encore
# commité, donc corriger revient à éditer un fichier et refaire `git add`.
# Dix secondes.
#
# Passé ce point, l'addition monte vite :
#   arrêté au pre-push  → la donnée est dans l'historique local, il faut rebase
#   passé au push       → git-filter-repo, re-signature des tags, force-push,
#                         purge du registre d'images, ticket au support GitHub
#                         pour la collecte des objets orphelins — et l'aveu
#                         qu'elle a été publique entre-temps.
#
# Le 28 juillet 2026, cette dernière colonne a coûté une journée entière pour
# des données entrées en quelques secondes. D'où ce hook, qui va plus loin que
# gitleaks : il cherche aussi les données PERSONNELLES (motifs hors dépôt) et
# les métadonnées des binaires indexés.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

if [ -x "$ROOT/scripts/audit-opsec.sh" ]; then
  if ! "$ROOT/scripts/audit-opsec.sh" --staged; then
    echo ""
    echo "❌ COMMIT BLOQUÉ."
    echo "   Pour passer outre en connaissance de cause : git commit --no-verify"
    echo "   (uniquement si tu viens de vérifier toi-même — pas par réflexe)"
    exit 1
  fi
  exit 0
fi

# Repli si l'audit ne peut pas tourner : au moins les secrets.
# Même remarque que dans l'autre hook — le test porte sur le bit d'exécution.
if [ -f "$ROOT/scripts/audit-opsec.sh" ]; then
  echo "⚠ scripts/audit-opsec.sh présent mais non exécutable."
  echo "  → scripts/install-hooks.sh pose le bit d'exécution."
else
  echo "⚠ scripts/audit-opsec.sh introuvable."
fi
echo "  Contrôle réduit aux secrets."
if ! command -v gitleaks >/dev/null 2>&1; then
  # 🔑 « aucune protection active » suivi d'exit 0 : le hook annonçait lui-même
  # qu'il ne protégeait rien, et laissait passer. Une alarme qui se sait morte
  # et le dit sans rien empêcher est le pire des trois états.
  echo "❌ COMMIT BLOQUÉ — gitleaks absent lui aussi, aucune protection active."
  echo "   https://github.com/gitleaks/gitleaks/releases"
  echo "   Passer outre en connaissance de cause : git commit --no-verify"
  exit 1
fi
if ! gitleaks protect --staged -c "$ROOT/.gitleaks.toml" --no-banner --redact; then
  echo ""
  echo "❌ COMMIT BLOQUÉ — donnée sensible détectée."
  echo "   → Corrige le contenu, ou ajuste l'allowlist si c'est un faux positif."
  exit 1
fi

# 🔑 gitleaks n'a rien trouvé — mais gitleaks ne cherche pas les données
# personnelles ni les métadonnées des binaires, qui sont l'objet même de
# l'audit absent. Sortir en 0 ici rendait le verdict d'un contrôle complet
# pour un contrôle partiel.
echo ""
echo "❌ COMMIT BLOQUÉ — seuls les secrets ont été examinés."
echo "   Les données personnelles et les métadonnées des binaires ne l'ont"
echo "   PAS été. Répare, ou passe outre : git commit --no-verify"
exit 1
