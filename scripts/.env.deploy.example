# Configuration du déploiement — copie ce fichier en `scripts/.env.deploy`
# et renseigne tes valeurs. Le fichier réel est gitignoré : il porte le nom
# d'hôte et le login de ta prod, qui n'ont rien à faire dans un dépôt public.
#
# Les adresses ci-dessous sont celles de la RFC 5737 (TEST-NET), réservées à
# la documentation : elles ne routent nulle part.

SELFFARM_DEPLOY_REMOTE=deploy@192.0.2.10
SELFFARM_DEPLOY_STAGE=selffarm-stage
SELFFARM_DEPLOY_PROD=/opt/selffarm-lite
SELFFARM_DEPLOY_IMMUT=/usr/local/sbin/prod-immutable.sh
SELFFARM_DEPLOY_SERVICE=selffarm-webapp
SELFFARM_DEPLOY_HEALTH="https://selffarm.example.org/healthz https://selffarm.example.org/ https://selffarm.example.org/compta"
