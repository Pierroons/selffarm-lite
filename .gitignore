# Données locales (runtime) — ancré à la racine : les data/ des modules
# sont des DONNÉES DE RÉFÉRENCE du logiciel (plan comptable, catalogue
# d'aides, catalogue de variétés), pas des données utilisateur. Sans elles
# le dépôt et l'image publiée sont fonctionnellement vides.
*.sqlite3
*.db
/data/
exports/
*.log

# YAML hypothèses persos (PII — adresse, nom complet, chiffres réels d'installation)
# Garder uniquement hypotheses-demo-publique.yaml (anonymisé Marie DUPONT Dordogne)
examples/hypotheses-pierroons*.yaml
examples/hypotheses-perso*.yaml

# Fixtures bancaires sensibles (relevés réels qui auraient échappé au fake-first)
modules/self_banking/fixtures/sg_real_*.pdf
modules/self_banking/fixtures/private/

